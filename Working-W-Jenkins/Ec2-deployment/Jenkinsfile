pipeline {
    agent any
    triggers {
        pollSCM('* * * * *')
    }
    environment {
        IMAGE_NAME = "shubhamm18/flask-app"
        MY_LOGIN   = credentials("dockerhub-creds")
        EC2_HOST   = "ubuntu@100.27.219.137"
        SSH_KEY    = credentials("ec2-ssh")
    }
    stages {
        stage("checkout") {
            steps {
                git branch: "main",
                    url: "https://github.com/Shubhamx18/jenkins-pipelines.git"
            }
        }
        
        stage("build docker image") {
            steps {
                dir("Working-W-Jenkins/Ec2-deployment") {
                    sh 'docker build -t $IMAGE_NAME:latest .'
                }
            }
        }

        stage("docker login & push") {
            steps {
                sh 'echo $MY_LOGIN_PSW | docker login -u $MY_LOGIN_USR --password-stdin'
                sh 'docker push $IMAGE_NAME:latest'
            }
        }

        stage("deploy to EC2 Kind cluster") {
            steps {
                sh '''
                    chmod 600 $SSH_KEY
                    
                    echo "Transferring deployment file to EC2..."
                    scp -i $SSH_KEY -o StrictHostKeyChecking=no -o ConnectTimeout=15 Working-W-Jenkins/Ec2-deployment/deployment.yml $EC2_HOST:~/
                    
                    echo "Applying deployment to Kind cluster on EC2..."
                    ssh -i $SSH_KEY -o StrictHostKeyChecking=no -o ConnectTimeout=15 $EC2_HOST "kubectl apply -f deployment.yml"
                '''
            }
        }

        stage("output") {
            steps {
                sh 'echo "deployed successfully to Kind cluster on EC2!"'
            }
        }
    }
}
