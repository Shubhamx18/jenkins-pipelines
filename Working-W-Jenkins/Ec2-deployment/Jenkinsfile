pipeline {
    agent { 
        label 'ec2-worker' 
    }
    
    triggers {
        pollSCM('* * * * *')
    }

    environment {
        IMAGE_NAME     = "shubhamm18/flask-app"
        IMAGE_TAG      = "${BUILD_NUMBER}"
        DOCKER_CREDS   = credentials('dockerhub-creds')
        KIND_CONTEXT   = "kind-my-cluster"
        WORKING_DIR    = "Working-W-Jenkins/Ec2-deployment"
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        ansiColor('xterm')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Shubhamx18/jenkins-pipelines.git'
            }
        }

        stage('Build Image') {
            steps {
                dir("${env.WORKING_DIR}") {
                    sh '''
                        echo "===> Building Docker Image: ${IMAGE_NAME}:${IMAGE_TAG}"
                        docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                        docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                    '''
                }
            }
        }

        stage('Registry Login & Push') {
            steps {
                sh '''
                    echo "===> Authenticating with Docker Hub"
                    echo "$DOCKER_CREDS_PSW" | docker login -u "$DOCKER_CREDS_USR" --password-stdin
                    
                    echo "===> Pushing Images to Registry"
                    docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Deploy to Kind') {
            steps {
                dir("${env.WORKING_DIR}") {
                    sh '''
                        echo "===> Setting Kubernetes Context"
                        kubectl config use-context ${KIND_CONTEXT}
                        
                        echo "===> Applying Manifests"
                        kubectl apply -f deployment.yml
                        
                        echo "===> Verifying Deployment Status"
                        kubectl rollout status deployment/flask-app-deployment --timeout=60s || true
                        kubectl get pods -l app=flask-app -o wide
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                echo "===> Cleaning Up Local Docker Artifacts"
                docker image prune -f --filter "until=24h" || true
            '''
        }
        success {
            echo "SUCCESS: Pipeline completed build #${BUILD_NUMBER} and deployed to Kind cluster."
        }
        failure {
            echo "FAILURE: Pipeline execution failed on build #${BUILD_NUMBER}."
        }
    }
}
