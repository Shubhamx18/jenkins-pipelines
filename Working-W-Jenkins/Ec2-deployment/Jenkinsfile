pipeline{
    agent any
    triggers{
    pollSCM('* * * * *')
    }
environment{
   IMAGE_NAME="shubhamm18/flask-app"
   MY_LOGIN=credentials("dockerhub-creds")
 //  AWS_LOGIN=credentials("aws-creds")
 }

stages{
   stage("get chckout"){
     steps{
       git branch: "main",
       url: "https://github.com/Shubhamx18/jenkins-pipelines.git"
          }
        }
   stage("build Docker Image using Dockerfile , present in Github"){
       steps{
          dir("Working-W-Jenkins/Ec2-deployment"){
        sh 'docker build -t $IMAGE_NAME:latest .'
              }
            }
         }
   stage('docker login & push !!!'){
      steps{
        sh 'echo $MY_LOGIN_PSW  | docker login -u $MY_LOGIN_USR --password-stdin'
        sh 'docker push $IMAGE_NAME:latest'
        sh ' echo "push successful" '
          }
       }
   }
}  
